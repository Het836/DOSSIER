# Copy this file to ".env" and fill in your real keys.
# ".env" itself should NEVER be committed to git or uploaded to your host's
# dashboard file browser — hosts have a separate "environment variables"
# section for this exact purpose (see the deployment steps).

TAVILY_API_KEY=tvly-your-key-here
GROQ_API_KEY=gsk-your-key-here
GROQ_MODEL=llama-3.3-70b-versatile
